---
import type { GetStaticPaths } from "astro";
import { siteConfig } from "@/config";
import Pagination from "../../components/control/Pagination.astro";
import PostPage from "../../components/PostPage.astro";
import {
	DEFAULT_LANG,
	PAGE_SIZE,
	SUPPORTED_LANG,
} from "../../constants/constants";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allPaths = [];

	for (const lang of SUPPORTED_LANG) {
		const postsForLang = await getSortedPosts(lang);
		const langParam = lang === DEFAULT_LANG ? undefined : lang;

		const paginatedPages = paginate(postsForLang, {
			params: { lang: langParam },
			pageSize: PAGE_SIZE,
			props: { lang },
		});

		allPaths.push(...paginatedPages);
	}

	return allPaths;
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page, lang } = Astro.props;

const len = page.data.length;

// The listing has no visible page heading, so give assistive tech and search
// engines one. Later pagination pages need their own label to stay unique.
const heading =
	page.currentPage === 1
		? siteConfig.title
		: `${siteConfig.title} - ${page.currentPage}`;
---

<MainGridLayout lang={lang}>
    <h1 class="sr-only">{heading}</h1>
    <PostPage page={page} lang={lang}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
